{
  "tasks": {
    "ingest": "deno run -A --env-file src/cli/ingest.ts",
    "dev": "deno run -A --env-file --watch src/api/server.ts",
    "test": "deno test -A --env-file",
    "db:generate": "deno run -A npm:drizzle-kit generate",
    "db:migrate": "deno run -A npm:drizzle-kit migrate"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/csv": "jsr:@std/csv@^1.0.6",
    "drizzle-kit": "npm:drizzle-kit@^0.31.10",
    "drizzle-orm": "npm:drizzle-orm@^0.45.2",
    "postgres": "npm:postgres@^3.4.9"
  }
}
